# Nevo production environment
NODE_ENV=production
PORT=10000
APP_URL=https://your-nevo-app.onrender.com

# PostgreSQL / Render database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# KoraPay — keep the secret key server-side only
KORAPAY_SECRET_KEY=sk_live_your_korapay_secret_key
KORAPAY_PUBLIC_KEY=pk_live_your_korapay_public_key

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# First admin account (required for a new database)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# Optional services
GEMINI_API_KEY=
SUPPORT_EMAIL=support@nevo.com
SUPPORT_PHONE=+2340000000000
WHATSAPP_NUMBER=+2340000000000
SENDER_NAME=Nevo
