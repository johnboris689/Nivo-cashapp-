# =======================================================
# SWIFTPAY ENVIRONMENT CONFIGURATION TEMPLATE
# =======================================================
# Copy this file to '.env' before running the application locally or deploying to Render.

# Server Port (Default is 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Base URL of your deployed application (e.g. https://swiftpay.onrender.com or http://localhost:3000)
APP_URL="http://localhost:3000"

# -------------------------------------------------------
# PAYMENT PROVIDER CONFIGURATION (PAYSTACK, FLUTTERWAVE, KORAPAY)
# -------------------------------------------------------
# Active payment gateway: 'paystack', 'flutterwave', or 'korapay'
# If omitted, the platform automatically detects and selects the first configured provider.
PAYMENT_PROVIDER="paystack"

# 1. Paystack API Credentials
# Obtain from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# 2. Flutterwave API Credentials
# Obtain from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-your_flutterwave_secret_key"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-your_flutterwave_public_key"
FLW_SECRET_HASH="your_flutterwave_webhook_secret_hash"

# 3. Korapay API Credentials
# Obtain from https://dashboard.korapay.com/settings/api-webhook
KORAPAY_SECRET_KEY="sk_test_your_korapay_secret_key"
KORAPAY_PUBLIC_KEY="pk_test_your_korapay_public_key"

# -------------------------------------------------------
# GEMINI AI API CONFIGURATION
# -------------------------------------------------------
# Required for SwiftPay Assistant AI Customer Support Chatbot.
# Obtain a free key at https://aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key_here"

# -------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------
# PostgreSQL Connection URL (e.g., Render PostgreSQL, Supabase, Neon, or local Postgres).
# If left empty, SwiftPay defaults to using its built-in persistent JSON database store (swiftpay_db.json).
DATABASE_URL="postgresql://user:password@localhost:5432/swiftpay"

